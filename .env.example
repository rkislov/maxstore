HTTP_ADDR=127.0.0.1:8080
S3_ADDR=127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
DATA_DIR=data
DEFAULT_PROVIDER=local
# 0 = no configured size limit; parts remain 8 MiB.
MAX_OBJECT_SIZE=0
# If omitted, credentials are generated in DATA_DIR/credentials.json.
# CONSOLE_TOKEN=replace-with-a-long-random-token
# S3_ACCESS_KEY=maxstore
# S3_SECRET_KEY=replace-with-a-long-random-secret
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=-1001234567890
# MAX_BOT_TOKEN=
# MAX_CHAT_ID=

# Optional initial admin credentials (first startup only; password 12–72 bytes).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password
# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false

# Concurrent provider operations, 1–16.
UPLOAD_CONCURRENCY=4
DOWNLOAD_CONCURRENCY=4
